# ==============================================================================
# GLOWUP AI - MOBILE APP PRODUCTION ENVIRONMENT CONFIGURATION (.env.production)
# ==============================================================================
# Copy this file to .env.production and fill in your production credentials
# before running: `eas build --platform android --profile production`
# ==============================================================================

# --- Backend Production API ---
EXPO_PUBLIC_API_URL=https://your-api.example.com

# --- Google OAuth Web & Android Clients ---
# From Google Cloud Console (Web application Client ID)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
# From Google Cloud Console (iOS application Client ID)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your_google_ios_client_id.apps.googleusercontent.com

# --- RevenueCat (In-App Subscriptions & Billing) ---
# From RevenueCat Project > API Keys > Public SDK Key (Google Play / App Store)
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=your_revenuecat_android_key
EXPO_PUBLIC_REVENUECAT_IOS_KEY=your_revenuecat_ios_key

# --- Google AdMob Production Rewarded Video Ads ---
# Replace test ID with your live production AdMob Unit ID from Google AdMob Dashboard
EXPO_PUBLIC_ADMOB_REWARDED_ID=ca-app-pub-xxxxxxxxxxxxxxxx/yyyyyyyyyy

# --- Stripe Companion Web Integration (Optional) ---
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key

# --- Support & Legal ---
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://your-domain.example.com/privacy
EXPO_PUBLIC_TERMS_URL=https://your-domain.example.com/terms
