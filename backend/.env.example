# ===========================================================
# GlowUp Backend — Environment Configuration Reference
# ===========================================================
# Copy this file to .env and fill in your real values.
# Any value starting with "placeholder" will trigger mock/fallback mode.
# ===========================================================

# Hono Server Configuration
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3005
FRONTEND_URL=http://localhost:3000
# CORS origin for production (full origin, no path). Example: https://your-domain.example.com
ALLOWED_ORIGIN=http://localhost:3000

# Mobile Deep Link Scheme (for Stripe redirect after checkout)
# Example: glowup:// — set to your app's registered URL scheme
MOBILE_SCHEME=glowup

# Security
# IMPORTANT: Change these in production!
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_STRING
WEBHOOK_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_WEBHOOK_SECRET

# PostgreSQL Database
# Use the same user, password, and database name as POSTGRES_USER, POSTGRES_PASSWORD, and POSTGRES_DB.
# Docker Compose (hostname is the db service): postgres://USER:PASSWORD@db:5432/DBNAME
# Local process against the published port:    postgres://USER:PASSWORD@localhost:5435/DBNAME
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/DBNAME

# Postgres settings read by docker compose (shell env, or a gitignored .env next to the compose file)
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=your_database_name

# ===== Cloudflare R2 S3-Compatible Storage =====
# Get these from Cloudflare Dashboard → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your-bucket-name
# Public domain for R2 bucket (custom domain or Cloudflare R2 public URL)
R2_PUBLIC_DOMAIN=https://your-cdn-domain.com

# ===== AI Generation — Google Gemini / Imagen 3 =====
# Get from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
# OR use Vertex AI (alternative)
VERTEX_API_KEY=
GOOGLE_PROJECT_ID=your_gcp_project_id
GOOGLE_LOCATION=us-central1

# ===== Stripe Payments =====
# Get from Stripe Dashboard → Developers → API Keys
STRIPE_API_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
# Create products in Stripe Dashboard and copy the Price IDs here
STRIPE_PRO_PRICE_ID=price_xxxxxxxxxxxxx
STRIPE_PREMIUM_PRICE_ID=price_xxxxxxxxxxxxx

# ===== Email Service (Resend or SMTP) =====
# Option A: Resend API (Get from https://resend.com/api-keys)
RESEND_API_KEY=re_your_resend_api_key

# Option B: Standard SMTP Credentials (for Gmail, SendGrid, AWS SES, Mailgun, etc.)
SMTP_HOST=placeholder_smtp_host
SMTP_PORT=587
SMTP_USER=placeholder_smtp_username
SMTP_PASS=placeholder_smtp_password
SMTP_SECURE=false

# Common Sender Address
EMAIL_FROM=GlowUp <hello@yourdomain.com>

# ===== Push Notifications — Firebase Cloud Messaging =====
# Get from Firebase Console → Project Settings
FIREBASE_PROJECT_ID=your_firebase_project_id
GOOGLE_APPLICATION_CREDENTIALS=

# ===== Native Authentication Client IDs =====
# Google: From Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID_IOS=your_google_ios_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_ID_ANDROID=your_google_android_client_id.apps.googleusercontent.com
# Apple: From Apple Developer → Certificates, Identifiers & Profiles
APPLE_CLIENT_ID_IOS=com.yourcompany.glowup
